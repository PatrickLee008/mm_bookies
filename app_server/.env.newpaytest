# IBC testing 联调环境（2026-10-29 临时）
# 用途：mm_bookies 支付中心改造期间，支付中心侧暂借 IBC 的测试地址与凭证。
# 切换方式：把 .env 里的 APP_ENV 改成 ibctest
#
# ⚠️ 三处必须同时一致，否则回调 AES 解密失败：
#   1) 本文件的 PAY_CENTER_APP_ID / PAY_CENTER_APP_AES_SECRET
#   2) Java 端 jp-console 对应 profile 的 app.pay.payAppid / paySecret
#   3) 支付中心后台为该 appid 登记的回调地址
# 正式环境请换成 mm_bookies 自己的 appid（三品牌各一套）。

# ==================== 日志配置 ====================
LOG_LEVEL=INFO
LOG_TO_FILE=True
LOG_DIR=logs
LOG_FILE_PREFIX=mmbookies
LOG_BACKUP_COUNT=30
LOG_MAX_BYTES=10485760

# ==================== 数据库配置 ====================
# 沿用开发库；若换测试库只改这四行
DB_ADDRESS=192.168.3.201
DB_USER=root
DB_PASSWORD=123456
DATABASE=mmbookies
PORT=8282

# ==================== 密钥配置 ====================
SECRET_KEY=abc123

# ==================== SQLAlchemy配置 ====================
SQLALCHEMY_POOL_SIZE=10000
SQLALCHEMY_POOL_TIMEOUT=10
SQLALCHEMY_POOL_RECYCLE=10600

# ==================== Redis配置 ====================
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_DB=0
REDIS_EXPIRE=60

# ==================== 支付配置（照抄 IBC TestingConfig 支付中心部分） ====================
# 对照源：IBC/Soccer6_App_Server/app_server/setting.py :: class TestingConfig
#
#   IBC TestingConfig                       → 本文件                是否照抄
#   PAY_CENTER_API=http://payapi.1x2mmm.net → 同                     ✅ 一致
#   PAY_CENTER_APP_ID=5625827305dea85a3c94b4173817e6fd
#   PAY_CENTER_APP_AES_SECRET=qfgZ2JkeZlf/H3BE1Yr6xQ==
#   CHARGE_RETURN_URL=http://mibc.frp...    → 同                     ✅ 一致（IBC 的 H5，上线换本站）
#   CHARGE_CALLBACK_URL=https://running-shopzilla-weddings-fridge.trycloudflare.com/openapi/jpay/recharge_callback
#                                           → /openapi/jpay/recharge_callback
#                                                                    ❌ 不能照抄：
#                                                                       IBC 回调进 Flask 管理端，
#                                                                       mm_bookies 回调进 Java jp-console，
#                                                                       且必须是本站可达域名
#   agentId                                 → 不配置，代码按会员所属代理的 aid 动态取

CHARGE_CALLBACK_URL=https://running-shopzilla-weddings-fridge.trycloudflare.com/openapi/jpay/recharge_callback
PAY_CENTER_API=http://payapi.1x2mmm.net
PAY_CENTER_APP_ID=5625827305dea85a3c94b4173817e6fd
PAY_CENTER_APP_AES_SECRET=qfgZ2JkeZlf/H3BE1Yr6xQ==
CHARGE_RETURN_URL=http://mibc.frp.1x2mmm.net

# 本项目适配项：IBC 用真实 AGENT_ID，本项目借其 appid 时 ag0101 不在白名单，
# 留空 = 显式传空 agentId 跳过映射校验。
# ⚠️ 正式环境必须删除本行（或改成支付中心已登记的 aid），否则充值不进代理结算。

# 降级兜底通道：仅当 /charge_apply/channels 请求失败时使用
PAY_CHANNEL_TYPE=VIPPay

