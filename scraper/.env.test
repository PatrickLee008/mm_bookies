# Decodo（原 Smartproxy）代理配置（新增）
# 用户名格式：user-{原用户名}-country-th-session-{会话ID}-sessionduration-60
# 说明：
#   - country-th: 指定泰国IP
#   - session-scraper001: 固定会话ID，保持同一IP
#   - sessionduration-60: 会话持续60分钟（1小时后自动换IP）
DECODO_PROXY_USERNAME=user-sp9y3nhxbw-country-th-session-scraper002-sessionduration-60
DECODO_PROXY_PASSWORD=ez8m5F~gl6jG9snvPU
DECODO_PROXY_HOST=gate.decodo.com
DECODO_PROXY_PORT=7000

# 选择使用哪个代理: local(原有代理) 或 decodo(Decodo代理)
USE_PROXY=local

# ==================== 数据库配置 ====================
DB_HOST=localhost
DB_PORT=3306
DB_USER=onex2_db
DB_PASSWORD=NthAiX2mRmNFWwr3
