# ===== db_sync 配置示例（复制为 .env 或用 compose environment 注入）=====

# 物理机 MySQL 连接（账号需对 源库+目标库 都有 SELECT/INSERT/UPDATE 权限）
DB_HOST=host.docker.internal
DB_PORT=3306
DB_USER=sync_user
DB_PASSWORD=change_me

# 主库（爬虫写入的库）
SYNC_SOURCE_DB=onex2_db_1
# 目标库（其余两套），逗号分隔
SYNC_TARGET_DBS=onex2_db_2,onex2_db_3

# 同步的表与水位列（表名:水位表达式；分号分隔）。留空则用内置默认(5张表)。
# SYNC_TABLES=m_app_match:COALESCE(UPDATE_TIME,CREATE_TIME);m_app_match_attr:COALESCE(UPDATE_TIME,CREATE_TIME);result:CREATE_TIME;m_app_league_team_scraper:COALESCE(update_time,create_time);m_app_league:COALESCE(update_time,create_time)

# 循环间隔（秒）
SYNC_INTERVAL=15
# 水位回退重叠秒（防边界漏行）
SYNC_OVERLAP_SECONDS=5
# 水位状态持久化文件
SYNC_STATE_FILE=/app/state/sync_state.json
# 只跑一轮（调试）
SYNC_RUN_ONCE=0
