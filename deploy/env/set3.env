# ===== 第 3 套（set3 · 副本，只刷缓存）=====  项目名固定用 mm_set3
IMAGE_TAG=latest

DATA_ROOT=/data/mmbookies/set3
CONFIG_ROOT=/data/mmbookies/set3/config
UNIAPP_DIST=/data/mmbookies/set3/web/uniapp
WEB_MANAGER_DIR=/data/mmbookies/set3/web/manager

DB_NAME=onex2_db_3

# ---- 爬虫角色：副本套只从本库重建 Redis 缓存，不做网页爬取 ----
SCRAPER_ENTRY=cache_only.py
SCRAPE_INTERVAL=30

# ---- 对外端口（set3 = 3xxxx 段）----
PORT_APP_SERVER=38282
PORT_JEEPLUS=38082
PORT_JXPUSH=38090
PORT_JXBOOT=39101
PORT_UNIAPP=38080
PORT_MANAGER=38081
PORT_REDIS=36379

XMX_JXBOOT=1536m
XMX_JEEPLUS=1536m
XMX_JXPUSH=1024m
