# ===== 第 1 套（set1 · 主套，跑完整爬虫）=====  项目名固定用 mm_set1
IMAGE_TAG=latest

# ---- 物理存储根目录：配置与数据都落这里 ----
DATA_ROOT=/data/mmbookies/set1
CONFIG_ROOT=/data/mmbookies/set1/config

# ---- 静态前端产物目录 ----
UNIAPP_DIST=/data/mmbookies/set1/web/uniapp
WEB_MANAGER_DIR=/data/mmbookies/set1/web/manager

# ---- 本套使用的数据库名（物理机 MySQL 上；实际连接信息在各服务 config 文件里）----
DB_NAME=onex2_db_1

# ---- 爬虫角色：主套跑完整爬虫 ----
SCRAPER_ENTRY=ibet_runner2.py
SCRAPE_INTERVAL=30

# ---- 对外端口（set1 = 1xxxx 段）----
PORT_APP_SERVER=18282
PORT_JEEPLUS=18082
PORT_JXPUSH=18090
PORT_JXBOOT=19101
PORT_UNIAPP=18080
PORT_MANAGER=18081
PORT_REDIS=16379

# ---- JVM 堆上限 ----
XMX_JXBOOT=1536m
XMX_JEEPLUS=1536m
XMX_JXPUSH=1024m
