# ===== 第 2 套（set2 · 副本，只刷缓存）=====  项目名固定用 mm_set2
IMAGE_TAG=latest

DATA_ROOT=/data/mmbookies/set2
UNIAPP_DIST=/data/mmbookies/set2/web/uniapp
WEB_MANAGER_DIR=/data/mmbookies/set2/web/manager

DB_NAME=onex2_db_2

# ---- 爬虫角色：副本套只从本库重建 Redis 缓存，不做网页爬取 ----
SCRAPER_ENTRY=cache_only.py
SCRAPE_INTERVAL=30

# ---- 对外端口（set2 = 2xxxx 段）----
PORT_APP_SERVER=28282
PORT_JEEPLUS=28082
PORT_JXPUSH=28090
PORT_JXBOOT=29101
PORT_UNIAPP=28080
PORT_MANAGER=28081
PORT_REDIS=26379

XMX_JXBOOT=1536m
XMX_JEEPLUS=1536m
XMX_JXPUSH=1024m
